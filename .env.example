# 成都地铁智能规划 — 环境变量配置
# 复制此文件为 .env 并填入你的配置

# DeepSeek API Key（必填，用于AI对话功能）
# 在 https://platform.deepseek.com/api_keys 获取
LLM_API_KEY=sk-your-api-key-here

# DeepSeek API 地址（默认值，无需修改）
LLM_API_BASE=https://api.deepseek.com/v1

# 模型选择（默认 deepseek-chat）
LLM_MODEL=deepseek-chat

# 运行端口（默认5000）
PORT=5000

# 运行模式：dev=开发模式(debug), prod=生产模式(Waitress)
MODE=prod
